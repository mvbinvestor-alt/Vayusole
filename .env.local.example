# Supabase (optional — not wired to any UI yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Beta gate ----
# The switch. "on" gates the whole site. Anything else (or unset) = open.
BETA_GATE=off

# Comma separated. Each entry is "label:code" or just "code".
# The label is never shown to users — it's so you know whose code was used.
BETA_CODES=mohan:heel-19,amy:sun-42

# Any long random string. Signs the session cookie.
BETA_SECRET=change-me-to-something-long-and-random
