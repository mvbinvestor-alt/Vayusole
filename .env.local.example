# ---- Tester sign-in (magic link) ----
# Leave both blank and the app runs open and anonymous, exactly as before.
# Set both and every visitor must sign in with an invited email address.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix this with NEXT_PUBLIC_ — it would ship to the
# browser and hand anyone full admin access to your project.
# Used only by /api/account so a tester can delete their own account.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Beta passcode gate (alternative to sign-in) ----
# You probably want ONE of these two mechanisms, not both.
BETA_GATE=off
BETA_CODES=mohan:heel-19,amy:sun-42
BETA_SECRET=change-me-to-something-long-and-random
